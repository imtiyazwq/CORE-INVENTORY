# Copy to database/.env for local overrides (gitignored — see .gitignore).
# On Render, set these as dashboard Environment Variables instead; app.py's
# load_dotenv() call is a no-op there since no database/.env file exists in
# the deployed container, so the platform's env vars are what actually apply.

# "true"  -> writes/reads go to Firestore (via the Admin SDK)
# "false" -> writes/reads go to the local SQLite store_inventory table
USE_FIREBASE=true

# Flask session cookie signing key. The hardcoded fallback in app.py is fine
# for local dev only — set a real random value on Render.
FLASK_SECRET_KEY=core-inventory-secret-key-2026
