# Optional Flask session security.
# You do NOT need an AI/Gemini API key for this build.
FLASK_SECRET_KEY="replace-with-a-long-random-secret"
SESSION_COOKIE_SECURE="false"

# Optional production database. If omitted, the Flask backend uses local SQLite.
# DATABASE_URL="postgresql://..."

# Frontend API base. Leave blank in local development because Vite proxies /api to Flask.
# VITE_API_BASE_URL=""
