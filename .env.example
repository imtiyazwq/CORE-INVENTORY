# Optional Flask session security.
# You do NOT need an AI/Gemini API key for this build.
FLASK_SECRET_KEY="replace-with-a-long-random-secret"
SESSION_COOKIE_SECURE="false"

# Optional production database. If omitted, the Flask backend uses local SQLite.
# DATABASE_URL="postgresql://..."

# Frontend API base. Leave blank in local development because Vite proxies /api to Flask.
# VITE_API_BASE_URL=""

# Optional: powers the Programme Consultant's DeepSeek-written "why this fits" narratives
# (see database/README.md). Without this, the guest planner still works - it just keeps
# its existing deterministic fit-reasons list instead of an AI-written summary.
# DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_MODEL="deepseek-chat"
